NODE_ENV=production
PORT=3000

DB_HOST=localhost
DB_USER=prakasa_user
DB_PASS=changeme
DB_NAME=prakasa_work_os
DB_POOL_LIMIT=5

JWT_SECRET=change_me_to_random_32_chars_minimum_xxxxxxxx
JWT_EXPIRES_IN=8h

# Bootstrap admin (DEV ONLY — hapus env setelah selesai)
# Script juga membutuhkan NODE_ENV != production.
# BOOTSTRAP_ALLOW=yes
# BOOTSTRAP_ADMIN_NAME=Super Admin
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_ENTITY_ID=1

# Google login is secondary/optional. Accounts must already be provisioned by Super Admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=prakasagroup.com

CORS_ORIGINS=https://prakasa-work-os.com,https://www.prakasa-work-os.com

# Google Drive (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=prakasa-drive@prakasa-work-os.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_ID=

# AI Providers (pilih per modul lewat ai_module_contexts)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Fase 3
SIGNATURE_ENCRYPTION_KEY=random_32_characters_minimum_xxxxxx
GOOGLE_CHAT_WEBHOOK_URL=

# Fase 6
GOOGLE_CALENDAR_DELEGATED_USER=

# Optional runtime
UPLOAD_DIR=uploads

# Public frontend URL used for document-verification QR links
PUBLIC_WEB_URL=https://prakasa-work-os.com


# Batch 3 — optional n8n AI application gateway
# The URL is server-controlled; users cannot supply arbitrary webhook URLs.
N8N_AI_GATEWAY_URL=
N8N_AI_GATEWAY_SECRET=
N8N_AI_GATEWAY_TIMEOUT_MS=120000
