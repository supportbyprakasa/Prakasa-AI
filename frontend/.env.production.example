# Production build settings for cPanel (copy to .env.production, then
# `npm ci && npm run build`). Vite bakes these in at build time: rebuild after
# any change. Never put secrets here; everything below ends up in the browser.

# API origin + /api/v1 (Node app on the api subdomain, HTTPS).
VITE_API_URL=https://api.<domain>/api/v1

# Google login is optional; email/password stays the primary method.
# The client ID is the public OAuth client "Prakasa Workspace Login"
# (Google Cloud project prakasa-work-os-local).
VITE_ENABLE_GOOGLE_LOGIN=false
VITE_GOOGLE_CLIENT_ID=
