{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "alias": [
    "prakasa-ai-web.vercel.app"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://prakasa-ai-api.vercel.app/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
