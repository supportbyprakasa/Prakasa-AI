# Contoh .env backend. Salin ke backend/.env (chmod 600), jangan di-commit.
# Production (cPanel "Setup Node.js App", API di https://api.<domain>, web di https://<domain>):
#   NODE_ENV=production — server MENOLAK start bila JWT_SECRET / SIGNATURE_ENCRYPTION_KEY
#   kosong, < 32 karakter, atau masih nilai contoh di file ini, atau DB_* belum lengkap.
#   CORS_ORIGINS=https://<domain>,https://www.<domain>
#   PUBLIC_WEB_URL=https://<domain>   APP_PUBLIC_URL=https://<domain>
#   ACCURATE_REDIRECT_URI=https://api.<domain>/api/v1/integrations/accurate/callback
#   PRAKASA_AGENT_API_URL=https://api.<domain>/api/v1
# Buat secret acak: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
NODE_ENV=production
# Di Passenger PORT diatur otomatis; nilai ini hanya untuk menjalankan lokal.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=prakasa_user
DB_PASS=changeme
DB_NAME=prakasa_work_os
# Koneksi database per proses. Aplikasi web: 5. Job cron (cron.env): 3, supaya
# web + beberapa job bersamaan tidak melewati batas koneksi MySQL shared hosting.
# Jangan dinaikkan: uji beban 1 Okt 2026 mengukur 10 dan 20 LEBIH LAMBAT dari 5
# (MySQL 2 vCPU jadi rebutan). Batas host: max_user_connections >= 5 + 3 x job
# cron yang bisa berjalan bersamaan (praktis >= 20).
DB_POOL_LIMIT=5

# Database transport security:
# disabled  = no TLS (default; local/cPanel compatibility)
# required  = TLS with certificate verification using Node/provider trust store
# verify-ca = TLS with certificate verification using DB_SSL_CA
DB_SSL_MODE=disabled
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

JWT_SECRET=change_me_to_random_32_chars_minimum_xxxxxxxx
JWT_EXPIRES_IN=8h

# Jumlah proxy di depan API (Passenger/LiteSpeed cPanel biasanya 1). Menentukan
# IP pengunjung untuk batas percobaan login per IP. Terlalu besar = IP bisa
# dipalsukan lewat header X-Forwarded-For; terlalu kecil = semua pengunjung
# dianggap satu IP (proxy). VERIFIKASI di host: panggil API dari dua jaringan
# berbeda dan pastikan log mencatat IP publik masing-masing, bukan IP proxy.
TRUST_PROXY=1
# Batas percobaan login GAGAL: per IP per menit, dan per email per 15 menit.
LOGIN_PER_IP_PER_MIN=30
LOGIN_PER_EMAIL_PER_15MIN=10

# Bootstrap admin (DEV ONLY — hapus env setelah selesai)
# Script juga membutuhkan NODE_ENV != production.
# BOOTSTRAP_ALLOW=yes
# BOOTSTRAP_ADMIN_NAME=Super Admin
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_ENTITY_ID=1

# Temporary first-production setup endpoint (remove after setup).
# Route only mounts when BOTH are set and token is exactly 64 hex characters.
# SETUP_ENABLED=yes
# SETUP_TOKEN=

# Google login is secondary/optional. Accounts must already be provisioned by Super Admin.
# GOOGLE_ALLOWED_DOMAIN accepts a comma-separated list if the Workspace org spans
# more than one verified domain (e.g. prakasagroup.com,prakasafoods.com).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The same list is the directory's work-email rule (People & Culture): a work
# email must be on one of these domains; without it no work email is accepted.
GOOGLE_ALLOWED_DOMAIN=prakasagroup.com,prakasafoods.com

# Daftar origin web yang boleh memanggil API — persis, dipisah koma. Production:
# hanya https://<domain> (tanpa localhost). Di development, bila ada origin localhost,
# port localhost mana pun ikut diizinkan (Vite pindah port); di production tidak.
CORS_ORIGINS=https://prakasa-work-os.com,https://www.prakasa-work-os.com
# 1 = izinkan juga preview Vercel lama (prakasa-ai-web*.vercel.app). Kosong di production.
CORS_ALLOW_VERCEL=

# Google Drive (service account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=prakasa-drive@prakasa-work-os.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_ID=
# Entitas pemilik data Sales untuk job pengingat (default 1).
SALES_ENTITY_ID=1
# Sumber transaksi Sales: 'accurate' = SO, surat jalan, invoice, pembayaran dan
# master produk dicatat di Accurate (aplikasi menampilkan read-only, form input
# & cetak disembunyikan); 'app' = semua diinput di aplikasi.
SALES_TRANSACTION_SOURCE=accurate
# Pengingat customer dormant (cron harian): 0 8 * * * node src/jobs/salesDormantReminder.js
# File AI tetap diproses di memory lalu langsung disimpan ke Shared Drive.
DOCUMENT_UPLOAD_MAX_BYTES=26214400
AI_DOCUMENT_MAX_BYTES=26214400
AI_DOCUMENT_MAX_EXTRACTED_CHARS=300000
# Context sent per message for Claude Team (flat subscription, large window). API providers
# keep a small fixed budget (5k chars per document, 14k total, 20 messages of history).
# Larger values let the AI read more but use more of the Team usage quota per message.
AI_LARGE_CONTEXT_CHARS=300000
AI_LARGE_HISTORY_CHARS=80000
# Development only: keep AI files on local disk (UPLOAD_DIR/ai-local) instead of
# Google Shared Drive. Refused when NODE_ENV=production.
# AI_DOCUMENT_STORAGE=local

# AI Providers
# Provider dapat dipilih per conversation. Secret hanya boleh berada di backend.
# Untuk shared/multi-user production, Claude subscription/Team login TIDAK
# digunakan sebagai credential aplikasi; gunakan metode server yang didukung
# provider bila Claude API diaktifkan.
# Model tiap provider diatur di Administrasi → AI Provider Settings (bukan di .env).
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=120000
ANTHROPIC_API_KEY=
CLAUDE_TIMEOUT_MS=120000
# Modern Claude models may reject custom sampling values. Leave this disabled.
CLAUDE_ALLOW_TEMPERATURE=no

# Claude Team subscription.
# Requires Claude Code already logged in on the runtime host (`claude auth login`).
# Enabled flag, accounts, divisions and model are managed by Super Admin at
# Administrasi → AI Provider Settings (gateway secrets are stored encrypted with
# SIGNATURE_ENCRYPTION_KEY). CLAUDE_TEAM_MODEL is only the gateway runner's
# fallback model; CLI path, timeout and workdir stay here.
# Do not use one Team seat as a shared multi-user production service.
CLAUDE_TEAM_MODEL=sonnet
CLAUDE_TEAM_CLI_PATH=claude
CLAUDE_TEAM_TIMEOUT_MS=120000
CLAUDE_TEAM_WORKDIR=

# Prakasa AI agent (docs/prakasa-ai-rencana.md): answers may read Prakasa data
# through tools (MCP), with the asking user's permissions. Runs only on the
# local Claude CLI login (not the gateway). The tool server calls back to this
# API; set PRAKASA_AGENT_API_URL when the API is not on 127.0.0.1:$PORT —
# in production (runner on another machine): https://api.prakasa-work-os.com/api/v1
# WAJIB di production: tanpa nilai ini Prakasa AI menjawab tanpa akses data
# (di luar production default-nya http://127.0.0.1:$PORT/api/v1).
AI_AGENT_ENABLED=true
AI_AGENT_DAILY_LIMIT=50
CLAUDE_TEAM_AGENT_TIMEOUT_MS=240000
PRAKASA_AGENT_API_URL=

# Prakasa AI proaktif (Gelombang D).
# Ringkasan pagi di Beranda: tanpa model AI. Bagian yang lebih lama dari batas
# waktu ini dilewati dan ditandai "belum sempat dimuat" (milidetik, minimal 200).
BRIEFING_BUDGET_MS=4000
# "Periksa dengan AI" pada batch Data Accurate: kapan perubahan nilai dokumen
# dianggap besar (persen ATAU rupiah), dan dokumen dianggap lama (hari).
ACCURATE_REVIEW_VALUE_PERCENT=20
ACCURATE_REVIEW_VALUE_RUPIAH=10000000
ACCURATE_REVIEW_BACKDATED_DAYS=30

# Optional: run Claude Team on a persistent machine and let Prakasa AI call it
# through a secret-protected HTTPS tunnel/gateway.
CLAUDE_TEAM_GATEWAY_URL=
CLAUDE_TEAM_GATEWAY_SECRET=
CLAUDE_TEAM_GATEWAY_HOST=127.0.0.1
CLAUDE_TEAM_GATEWAY_PORT=3199
CLAUDE_TEAM_GATEWAY_TIMEOUT_MS=360000

# Keeping one seat stable (docs/claude-team-runner.md): at most N CLI runs at
# once, the rest queue (users see their place); a full or slow queue fails with
# a clear message. A seat out of quota is paused until its reset time.
CLAUDE_TEAM_MAX_CONCURRENT=2
CLAUDE_TEAM_MAX_QUEUE=20
CLAUDE_TEAM_QUEUE_TIMEOUT_MS=120000
CLAUDE_TEAM_RETRY_DELAY_MS=1500

# Fase 3
SIGNATURE_ENCRYPTION_KEY=random_32_characters_minimum_xxxxxx
GOOGLE_CHAT_WEBHOOK_URL=

# Fase 6
GOOGLE_CALENDAR_DELEGATED_USER=

# Fase 7 (Google Chat Spaces) — reuses GOOGLE_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY above.
# The Workspace admin must grant that service account's domain-wide delegation the
# chat.spaces / chat.messages / chat.memberships scopes (Admin Console > Security >
# API controls > Domain-wide delegation), the same place Calendar's scopes were added.
GOOGLE_CHAT_DELEGATED_USER=

# Fase 8 (Gmail) — reuses GOOGLE_SERVICE_ACCOUNT_EMAIL/PRIVATE_KEY above. The
# Workspace admin must grant that service account's domain-wide delegation the
# gmail.send scope (same Admin Console screen as Calendar/Chat) for any
# notification_rules row with channel='email' to actually deliver.
GOOGLE_GMAIL_SENDER=

# Masa uji (sebelum go-live): SEMUA email aplikasi dialihkan ke satu alamat
# ini, bukan ke penerima aslinya (judul email menyebut untuk siapa).
# Di luar production, bila ini dan EMAIL_TEST_ALLOWLIST kosong, tidak ada
# email yang dikirim sama sekali. Kosongkan keduanya saat go-live.
EMAIL_TEST_REDIRECT=support@prakasagroup.com
# Alternatif: hanya alamat di daftar ini yang menerima email (pisahkan koma).
EMAIL_TEST_ALLOWLIST=

# Fase 9 (Admin Directory) — read-only Workspace member sync. Directory API
# cannot be called as the service account itself; it must impersonate a real
# Workspace Super Admin. Requires the admin.directory.user.readonly scope on
# that service account's domain-wide delegation (same Admin Console screen).
GOOGLE_ADMIN_DELEGATED_USER=

# Fase 10 (My Drive pribadi) — no new env var: every call impersonates the
# logged-in user themselves (their own users.email), not a fixed delegated
# account. Requires the full https://www.googleapis.com/auth/drive scope on
# the service account's domain-wide delegation (same Admin Console screen as
# Calendar/Chat/Gmail) — without it, "My Drive Saya" fails with
# GOOGLE_ACCOUNT_NOT_LINKED for every user, not just one. A user whose
# Prakasa Workspace email doesn't match a real Google Workspace account
# (e.g. a guessed email from manual import) will still hit that error even
# once the scope is granted — fix their email, not the scope.

# Fase 11 (Google apps di dalam Prakasa Workspace) — tidak ada env var baru.
# Gmail, Chat, Calendar, Docs/Sheets/Slides bertindak sebagai user yang login
# (domain-wide delegation, subject = email user). Scope DWD yang dibutuhkan pada
# Client ID service account (Admin Console > Security > API controls > DWD):
#   gmail.modify (baca kotak masuk)  · gmail.send · gmail.compose
#   chat.spaces · chat.messages · chat.memberships
#   calendar.events · drive
#   admin.directory.group.readonly · admin.directory.group.member.readonly (Groups,
#   memakai GOOGLE_ADMIN_DELEGATED_USER)
# Google Analytics TIDAK memakai DWD: aktifkan "Google Analytics Admin API" dan
# "Google Analytics Data API" di Google Cloud project service account, lalu
# tambahkan email service account sebagai Viewer di GA > Admin > Property access.

# Marketing → Insight (sesi website): property GA website perusahaan, format
# properties/123456789, bila service account melihat beberapa property.
# Kosong = property pertama yang bisa dibaca.
MARKETING_GA_PROPERTY=

# Optional runtime
UPLOAD_DIR=uploads

# URL web (frontend) untuk link QR verifikasi dokumen dan kembali dari login Accurate.
# WAJIB di production (https://<domain>); tanpa nilai ini QR verifikasi ditolak.
PUBLIC_WEB_URL=https://prakasa-work-os.com

# Pembaruan langsung (SSE /api/v1/realtime/stream). 0 = dimatikan: endpoint menjawab
# 503 REALTIME_DISABLED dan halaman tetap jalan tanpa pembaruan langsung. Pakai 0 bila
# proxy hosting menahan (buffer) respons panjang. Kosong/1 = aktif.
# Shared hosting: 0, KECUALI host memastikan stream SSE tidak dihitung sebagai
# Entry Process, atau batas EP >= 150 (tiap tab terbuka = 1 stream, maks 2 per user).
REALTIME_ENABLED=1

# Cache hasil di memori proses (uji beban 1 Okt 2026): dashboard, laporan dan
# status login disimpan sebentar (dashboard 120 dtk, laporan 60 dtk, login 30 dtk)
# dan dibuang saat data berubah. Asumsi: SATU proses Node (Passenger 1 instance).
# RESULT_CACHE=0 mematikan semua cache (darurat). AUTH_CACHE_TTL_MS: lama status
# login disimpan, 0 = mati, maks 60000. DASHBOARD_WARMUP=0 mematikan pemanasan
# dashboard divisi setelah start (default: 15 detik setelah start,
# DASHBOARD_WARMUP_DELAY_MS).
RESULT_CACHE=1
AUTH_CACHE_TTL_MS=30000
DASHBOARD_WARMUP=1
DASHBOARD_WARMUP_DELAY_MS=15000

# Batas permintaan per pengguna (memori proses; cukup untuk satu proses Passenger).
# 0 = batas dimatikan.
RATE_LIMIT_AI_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_10MIN=60
# "Periksa dengan AI" pada batch Data Accurate: berapa kali per jam untuk tiap orang.
RATE_LIMIT_BATCH_REVIEW_PER_HOUR=6

# Retensi data (job harian src/jobs/retention.js): integration_logs lebih tua dari N hari
# dan notifikasi yang SUDAH DIBACA lebih tua dari N hari dihapus (minimal 30).
# activity_logs, log audit lain, dan mirror Accurate tidak pernah dihapus.
RETENTION_INTEGRATION_LOG_DAYS=90
RETENTION_NOTIFICATION_DAYS=180

# Batas waktu (ms): cek database di /api/health, shutdown halus saat restart, dan
# job cron menunggu email/log latar belakang sebelum menutup koneksi database.
HEALTH_DB_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
JOB_FLUSH_TIMEOUT_MS=15000


# Batch 3 — optional n8n AI application gateway
# The URL is server-controlled; users cannot supply arbitrary webhook URLs.
N8N_AI_GATEWAY_URL=
N8N_AI_GATEWAY_SECRET=
N8N_AI_GATEWAY_TIMEOUT_MS=120000

# Accurate Online — "Sambungkan Accurate" (OAuth 2.0, HANYA BACA)
# Aplikasi tidak pernah menulis ke Accurate: semua panggilan lewat
# src/services/accurate/accurateReadOnly.js dan hanya scope *_view yang diterima.
# Daftarkan aplikasi di developer area Accurate (Platform: Website) dengan URL
# OAuth Callback PERSIS sama dengan ACCURATE_REDIRECT_URI. Client ID/Secret hanya
# di .env server — jangan di-commit, jangan ditempel di chat.
ACCURATE_CLIENT_ID=
ACCURATE_CLIENT_SECRET=
# Production: https://api.prakasa-work-os.com/api/v1/integrations/accurate/callback
ACCURATE_REDIRECT_URI=
# Biarkan kosong: aplikasi meminta tepat 50 izin *_view yang disetujui owner
# (VIEW_SCOPES di accurateReadOnly.js). Diisi hanya untuk MEMPERSEMPIT daftar itu;
# scope di luar daftar, atau selain *_view, membuat penyambungan ditolak.
ACCURATE_SCOPES=
# Sinkron berkelanjutan (src/jobs/accurateSync.js, dijalankan tiap 5 menit):
# jenis tarikan yang ikut, dipisah koma — sales, warehouse. Kosong = sales.
ACCURATE_SYNC_SCOPES=
# Jeda antar halaman API Accurate (ms, default 250) dan jeda dasar sebelum mencoba
# ulang saat Accurate sibuk (ms × percobaan, default 2000). Biasanya biarkan kosong.
ACCURATE_SYNC_DELAY_MS=
ACCURATE_SYNC_RETRY_MS=
# 1 = tarikan warehouse ikut membaca dokumen gudang (surat jalan, penerimaan,
# pindah gudang, penyesuaian stok). Jumlah saja, tanpa harga dan tanpa alamat.
ACCURATE_WAREHOUSE_DOCUMENTS=
# 1 = tarikan warehouse ikut membaca satuan tiap barang (satuan dasar dan rasio).
ACCURATE_ITEM_UNITS=
# 1 = tarikan warehouse ikut membaca SO yang belum terkirim penuh (jadwal kirim; jumlah saja).
ACCURATE_WAREHOUSE_SO=
# 1 = tarikan Procurement (pemasok dan PO) boleh berjalan; lalu tambahkan 'procurement' ke ACCURATE_SYNC_SCOPES.
ACCURATE_PROCUREMENT=
# 1 = tarikan Finance boleh berjalan: HANYA faktur pembelian dan pembayaran pembelian
# (utang ke pemasok), baca saja; batch disetujui Supervisor/Head Finance. Buku besar,
# jurnal, saldo akun, laporan keuangan dan pajak tidak pernah ditarik. Lalu tambahkan
# 'finance' ke ACCURATE_SYNC_SCOPES. Kosong = mati.
ACCURATE_FINANCE=
# PO sebelum tanggal ini "PO lama" (tidak dieskalasi). Kosong = 2026-09-22.
PROCUREMENT_LATE_FROM=
# SO sebelum tanggal ini tidak dihitung di OTIF Warehouse dan tidak dieskalasi (data Accurate diisi mundur). Kosong = 2026-09-22.
WAREHOUSE_OTIF_FROM=
# 1 = batch yang menunggu diingatkan (8 jam) lalu dieskalasi ke Head dan owner
# (tiap hari) oleh job sinkron; notifikasi dalam aplikasi.
ACCURATE_BATCH_REMINDERS=
# Pengaju batch; kosong = Super Admin yang menyambungkan Accurate.
ACCURATE_SYNC_USER_ID=
# Satu-satunya database yang boleh dipilih (dicocokkan dengan alias di db-list).
# Nama yang mengandung "Trial" selalu ditolak.
ACCURATE_DB_NAME="PT. PRAKASA FOODS NUSANTARA"
# Token disimpan terenkripsi (AES-256-GCM) memakai SIGNATURE_ENCRYPTION_KEY.
# Setelah login Accurate, browser dikembalikan ke PUBLIC_WEB_URL/admin/accurate.

# Accurate batches: the owner's account may decide any division's batch, next
# to the division's own Supervisor/Head (owner decision 29 Sep 2026). Empty =
# only the divisions decide.
ACCURATE_OWNER_DECIDER_EMAIL=

# People & Culture — IT device report import. The entity's code in the group's
# device report ("Company" column). Default: initials of the entity name
# (Prakasa Foods Nusantara → PFN). Set only if the report uses another code.
# IT_REPORT_ENTITY_CODE=

# Bantuan IT: copy of every new IT ticket to this mailbox (IT can change it in Tiket IT → Pengaturan email).
IT_SUPPORT_EMAIL=support@prakasagroup.com
# Public URL of the app, used for links inside emails (e.g. https://workspace.prakasagroup.com).
APP_PUBLIC_URL=
