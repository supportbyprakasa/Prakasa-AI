# Copy to ~/.prakasa-work-os-cron.env and chmod 600.
# Never commit the real file.

NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_USER=<cpanel database user>
DB_PASS=<production database password>
DB_NAME=<cpanel database name>
DB_POOL_LIMIT=5
DB_SSL_MODE=disabled
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

JWT_SECRET=<same value as Node.js App>
SIGNATURE_ENCRYPTION_KEY=<same value as Node.js App>
PUBLIC_WEB_URL=https://prakasa-work-os.com
UPLOAD_DIR=uploads

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_CALENDAR_DELEGATED_USER=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
N8N_AI_GATEWAY_URL=
N8N_AI_GATEWAY_SECRET=
N8N_AI_GATEWAY_TIMEOUT_MS=120000

# NODE_BIN=/opt/cpanel/ea-nodejs20/bin/node
