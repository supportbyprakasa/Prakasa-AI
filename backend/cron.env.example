# Copy to ~/.prakasa-work-os-cron.env and chmod 600.
# Never commit the real file.
# Nilai secret dan database HARUS sama dengan backend/.env aplikasi web. Job tidak
# memeriksa konfigurasi saat start, jadi salin nilainya persis.

NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_USER=<cpanel database user>
DB_PASS=<production database password>
DB_NAME=<cpanel database name>
# Job cron cukup 3 koneksi (aplikasi web memakai 5); total tetap di bawah batas MySQL hosting.
DB_POOL_LIMIT=3
DB_SSL_MODE=disabled
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

JWT_SECRET=<same value as Node.js App>
SIGNATURE_ENCRYPTION_KEY=<same value as Node.js App>
# URL web untuk link di email/notifikasi dan QR (https://<domain>).
PUBLIC_WEB_URL=https://prakasa-work-os.com
APP_PUBLIC_URL=https://prakasa-work-os.com
UPLOAD_DIR=uploads

# Pengirim email notifikasi (dipakai job pengingat). Kosong = email tidak dikirim.
GOOGLE_GMAIL_SENDER=

# Masa uji (sebelum go-live): SEMUA email aplikasi dialihkan ke satu alamat
# ini, bukan ke penerima aslinya (judul email menyebut untuk siapa).
# Di luar production, bila ini dan EMAIL_TEST_ALLOWLIST kosong, tidak ada
# email yang dikirim sama sekali. Kosongkan keduanya saat go-live.
EMAIL_TEST_REDIRECT=support@prakasagroup.com
# Alternatif: hanya alamat di daftar ini yang menerima email (pisahkan koma).
EMAIL_TEST_ALLOWLIST=

# Job retensi harian (src/jobs/retention.js): hari simpan integration_logs dan
# notifikasi yang sudah dibaca. Kosong = 90 / 180.
RETENTION_INTEGRATION_LOG_DAYS=
RETENTION_NOTIFICATION_DAYS=
# Batas waktu (ms) job menunggu email/log latar belakang sebelum menutup koneksi database.
JOB_FLUSH_TIMEOUT_MS=15000

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHARED_DRIVE_ID=
GOOGLE_CALENDAR_DELEGATED_USER=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
N8N_AI_GATEWAY_URL=
N8N_AI_GATEWAY_SECRET=
N8N_AI_GATEWAY_TIMEOUT_MS=120000

# NODE_BIN=/opt/cpanel/ea-nodejs20/bin/node

# Job accurateSync / accurateTokenRefresh: salin juga semua ACCURATE_* dari backend/.env
# (ACCURATE_CLIENT_ID, ACCURATE_CLIENT_SECRET, ACCURATE_REDIRECT_URI, ACCURATE_DB_NAME,
# ACCURATE_SYNC_SCOPES, ACCURATE_BATCH_REMINDERS, …).
